{
  "name": "tfdt/table-module",
  "d4Shortcode": "",
  "title": "Divi Table",
  "titles": "Divi Tables",
  "moduleIcon": "tfdt/table-module",
  "moduleClassName": "tfdt_table_module",
  "moduleOrderClassName": "tfdt_table_module",
  "category": "module",
  "childModuleName": "tfdt/table-row",
  "childModuleTitle": "Table Row",
  "childrenName": [
    "tfdt/table-row"
  ],
  "allowAllElements": false,
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "default": {
        "meta": {
          "adminLabel": {
            "desktop": {
              "value": "Table Module"
            }
          }
        }
      },
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "htmlAttributes": {}
        },
        "decoration": {}
      }
    },
    "tableTheme": {
      "type": "object",
      "default": {
        "innerContent": {
          "desktop": {
            "value": "default"
          }
        }
      },
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupSlug": "tableThemeGroup",
            "priority": 10,
            "render": true,
            "attrName": "tableTheme.innerContent",
            "label": "Table Style Theme",
            "features": {
              "sticky": false,
              "responsive": false,
              "hover": false
            },
            "component": {
              "name": "divi/select",
              "type": "field",
              "props": {
                "options": {
                  "default": {
                    "label": "Default"
                  },
                  "bordered": {
                    "label": "Bordered"
                  },
                  "striped": {
                    "label": "Striped"
                  },
                  "dark": {
                    "label": "Dark"
                  },
                  "no-style": {
                    "label": "No Style"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "customCssFields": {},
  "settings": {
    "content": "auto",
    "design": "auto",
    "groups": {
      "tableThemeGroup": {
        "panel": "design",
        "priority": 30,
        "groupName": "tableThemeGroup",
        "component": {
          "name": "divi/composite",
          "props": {
            "groupLabel": "Style Theme"
          }
        }
      }
    }
  }
}